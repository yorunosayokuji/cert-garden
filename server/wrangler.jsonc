{
  // cert-garden backend。D1 cert-garden は2026-10-20に専用account内で作成済み（APAC hint。国内保管の保証ではない）。
  // Worker未deploy。vars は、公開識別子のGoogle iOSクライアントID（GOOGLE_CLIENT_IDS）だけ設定済み。Appleの3項目は空（Appleは503で拒否）、APP_ENVはdevelopmentのまま。
  // 秘密は vars に置かず `wrangler secret put` で入れる（名前は README / .dev.vars.example）。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cert-garden-api",
  "account_id": "87fdf9b9b2ca657cdfbce7e4ffe59c53",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cert-garden",
      "database_id": "92dd7c1b-b6d5-459b-a5b4-bf6c2b424f7e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "ALLOWED_ORIGINS": "",
    "GOOGLE_CLIENT_IDS": "99697541013-7vqs8qopvg0vtdi5q9kmc2k0jjl0fhgv.apps.googleusercontent.com",
    "APPLE_CLIENT_ID": "",
    "APPLE_TEAM_ID": "",
    "APPLE_KEY_ID": "",
    "ACCESS_TTL_SECONDS": "900",
    "REFRESH_TTL_SECONDS": "2592000"
  }
}
