node_modules/
dist/
dist-ios-design/
dist-native/
dist-native-compare/
dist-native-flag/
.expo/
.audit.tmp.json
# 私的な記録・撮影・ローカルの確認用
IOS_*_RECEIPT.json
*RECEIPT*.json
screenshots/
e2e/
# 秘密になりうる物
.env
.env.*
*.p8
*.pem
*.p12
*.mobileprovision
